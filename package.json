{
  "name": "archive001",
  "version": "0.5.0",
  "private": true,
  "description": "archive001:一个会调工具的 agent。内核包 `@archive001/agent`(SDK),每个客户端各自成包(`packages/client/`:repl / cli / web …)。",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @archive001/repl dev",
    "watch": "pnpm --filter @archive001/repl watch",
    "start": "pnpm --filter @archive001/repl start",
    "cli": "pnpm --filter @archive001/cli dev",
    "smoke": "pnpm --filter @archive001/repl smoke",
    "build": "pnpm -r --if-present build",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test",
    "tui": "pnpm --filter @archive001/tui dev",
    "web": "pnpm --filter @archive001/web dev",
    "desktop": "pnpm --filter @archive001/desktop dev",
    "mobile": "pnpm --filter @archive001/mobile dev",
    "typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit",
    "web:host": "node packages/client/web/src/host/main.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "5.0.4"
  }
}

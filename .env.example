# 复制成 .env 后填值(或直接用环境变量注入,别提交 .env)

# 密钥(必填);也可用通用 API_KEY
DEEPSEEK_API_KEY=

# 端点与模型(留空 = 默认值)
# BASE_URL=https://api.deepseek.com
# MODEL=deepseek-flash

# 思考档位:off | low | high | max(默认 low)—— 与 DeepSeek 的 effort 同名
# 走哪条 wire 由内核内部决定(responses),不是环境变量
THINKING=low


# 输出被重定向 / 管道时本就不着色;想强制关掉终端颜色设:
# NO_COLOR=1
